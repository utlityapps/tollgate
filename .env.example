# Copy to .env and fill in what you have. Every value is optional:
# with nothing set, Tollgate runs with mock payments and a rule-based judge.

# --- PayPal SANDBOX (https://developer.paypal.com/dashboard/applications/sandbox) ---
# Create a sandbox app, then paste its credentials. Tollgate refuses to talk to any
# non-sandbox PayPal host unless TOLLGATE_ALLOW_LIVE=1 (do not set that).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional. Only needed if you register a sandbox webhook that points at /webhooks/paypal.
PAYPAL_WEBHOOK_ID=
# Optional. Your sandbox business account's merchant id: Tollgate then refuses to capture
# an order that pays anyone else.
PAYPAL_MERCHANT_ID=

# --- LLM judge and demo agent (optional) ---
# Adds a Claude judge on top of the rule-based one. The judge can only make a
# decision stricter, never looser.
ANTHROPIC_API_KEY=
# TOLLGATE_JUDGE_MODEL=claude-haiku-5-5
# TOLLGATE_AGENT_MODEL=claude-sonnet-5-5

# --- Secrets: required before Tollgate will listen beyond localhost ---
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
TOLLGATE_SIGNING_KEY=
TOLLGATE_ADMIN_TOKEN=
TOLLGATE_AGENT_TOKEN=

# --- Server ---
# Where PayPal sends the buyer back to after approval. Must be reachable by your browser.
PUBLIC_BASE_URL=http://localhost:8000
# TOLLGATE_DB=tollgate.db
# TOLLGATE_QUOTE_TTL=900

# --- MCP server, remote mode ---
# TOLLGATE_URL=http://localhost:8000
# TOLLGATE_MANDATE_ID=
