{
  "name": "Tollgate",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "postCreateCommand": "pip install -e '.[dev]'",
  "postStartCommand": "nohup tollgate serve --host 0.0.0.0 --port 8000 > /tmp/tollgate.log 2>&1 &",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Tollgate dashboard", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
